# Shared secret the PayBox plugin sends as the x-hyde-key header (configure it in the PayBox
# developer portal as a brokered secret for this host). At least 16 characters.
HYDE_API_KEY=
# Relayer hot wallet: opens exit boxes on Base (a few cents of gas each). Needs ~$2-3 of ETH on Base.
# Never holds user funds; Circle's Forwarding Service completes delivery on the destination chain.
RELAYER_PRIVATE_KEY=0x...
# ExitBoxFactory on Base mainnet (deployed; redeploy with contracts: npm run deploy -- --network base)
EXIT_BOX_FACTORY=0x5f0b5c773e04bb1173d7ea8e174442f4f22d53a7
# Relayer fee per cross-chain send, in USDC
RELAYER_FEE_USDC=0.03
# Optional RPC overrides (public RPCs otherwise; a private Base RPC is recommended)
BASE_RPC_URL=
PORT=8787
